[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="hitboxes"
3d_physics/layer_4="loot"
3d_physics/layer_5="vehicles"
3d_physics/layer_6="camera_blockers"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
textures/default_filters/anisotropic_filtering_level=2
