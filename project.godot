; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this file is generated so it can be committed.

config_version=5

[application]

config/name="King of the Mountain"
run/main_scene="res://game/main/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://game/autoload/settings.gd"
Events="*res://game/autoload/events.gd"
Net="*res://game/autoload/net.gd"

[debug]

gdscript/warnings/untyped_declaration=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

